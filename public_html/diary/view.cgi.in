use strict;
use lib qw(lib);

use CGI::QueryString;
use CGI::Tools;
use SimpleDB::Scalar;
use HNS::Admini;

require './config.ph';

my $admini = new HNS::Admini;

################################################################
# header
$admini->PrintHeader("ユーザメッセージ表示ツール");

# check authorized
$admini->CheckAuthorized;

# print requested data file
my $type = param('type');

print "<pre>";
if ($type eq 'mesg'){
    my $msg;
    print "<h1>ユーザからのメッセージ</h1>";
    tie $msg, 'SimpleDB::Scalar', $admini->message_file;
    print Escape($msg);
} elsif ($type eq 'ruri'){
    print "<h1>ruri-map</h1>";
    my $map;
    tie $map, 'SimpleDB::Scalar', $admini->ruri_map_file;
    print Escape($map);
} else {
    print "parameter 'type' must be 'mesg' or 'ruri'";
}
print qq(<a name="last">EOF</a>);
print "</pre>";

# footer
$admini->PrintFooter("HNS View Message-$version, ");

exit 0;
# end of view.cgi
################################################################
    
