use strict;
use lib qw(lib);

use CGI::QueryString;
use CGI::Tools;
use CodeConv;
use DateTime::Time;

use HNS::Admini;
use HNS::System;

require './config.ph';

BEGIN {
    $| = 1;
    $SIG{'__DIE__'} = \&die_handler;
}

################################################################
#初期設定
#日記のURL
my $DiaryURI			= $HNS::System::MyDiaryURI;
#hnfのあるディレクトリ
my $DiaryDir			= $HNS::System::DiaryDir;
#分散管理1/集中管理0
my $HnfDir			= 1;
#mail2nikkiのアドレス
my $ToUserAddress		= '%DIARYMAIL%';
#Fromのアドレス
my $FromUserAddress	        = '%FROMADDR%';
#sendmailの場所
my $Sendmail			= '%SENDMAIL_PATH%';
#日付変更offset
my $DateChangeOffset    = 4; # hours

# file writing mode
# 0 -> mail2nikki, 1 -> ftp client, 2 -> direct(SuExec Only)
my $Mode                = 0;


# where is ftp client?
my $Ftp			= '%FTP_PATH%';
# ftp host
my $FtpHost             = '%FTP_HOST%';
# ftp user
my $FtpUser             = '%FTP_USER%';
# ftp diary dir
my $FtpDiaryDir		= '%FTP_DIARY_DIR%';
# permission for created dir
my $Permission         = 0755;

################################################################
#メイン

# print "content-type: text/html\n\n";

# 乱数の種
srand( time() ^ ($$ + ($$ << 15)) );

#現在時刻取得
my $now_time = new DateTime::Time;
$now_time->SetTime($^T+$HNS::System::TZ*3600);

# テンポラリファイルリスト
my @tempfiles;

# secret生成
my @salts = ( "A".."Z", "a".."z", "0".."9", ".", "/" );
my $salt = $salts[int(rand(64))] . $salts[int(rand(64))];
my $admini = new HNS::Admini;
my $id = $admini->status->id;
my $secret = crypt(substr($id, 4), $salt);

#条件分岐

my $object = param('object') || param('keywords');
if ($object eq 'P') {
    &PlanMain;
} elsif ($object eq 'T') {
    &TodoMain;
} elsif ($object eq 'R') {
    &RepeatMain;
} else {
    &DiaryMain;
}

# テンポラリファイルを削除
&unlink_temp_files;

#終了
exit;



################################################################
# 各アクション用関数(hnf用)

# hns(日記ファイル)
sub DiaryMain ()
{
    my $action = param('action');
    my $year = CGI::Tools::Escape(param('year'));
    my $month = CGI::Tools::Escape(param('month'));
    my $day = CGI::Tools::Escape(param('day')); 

    if ($action eq "display") {    #指定日のhnfを編集画面に表示
	DisplayDiary($year, $month, $day);
    } elsif ($action eq "delete"){ #指定日のhnfを削除
	DeleteDiary(param('year'), param('month'), param('day'), param('password'));
    } elsif ($action eq "edit") { #指定日のhnfを登録
	RegistDiary(param('year'), param('month'), param('day'), param('password'),
	       param('body'));
    } else {                      #今日のhnfを表示
	if ($DateChangeOffset > $now_time->hour){  #オフセット時間内なら前日のhnfを表示
	    $now_time -= '-1D';
	}
	DisplayDiary($now_time->year,$now_time->month, $now_time->day);
    }
}

#指定日のhnfを編集画面に表示
sub DisplayDiary ($$$)
{
    my ($year, $month, $day) = @_;
	
    my $file = &makehnfname($year,$month,$day);

    my $text = undef;
    if (open (INHNF,"$file")){
	$text = join('', <INHNF>);
	CodeConv::toeuc(\$text);  #EUCに変換
	$text = &HtmlEscape($text);
    }

    # 昨日の日付を取得
    my $last_day = new DateTime::Date(year=>$year, month=>$month, day=>$day);
    $last_day--;
    my ($y_year,$y_month,$y_day) = ($last_day->year, $last_day->month, $last_day->day);
    ################
    # 編集画面を表示

    #ヘッダ出力
    my $admini = new HNS::Admini;
    $admini->PrintHeader('HNS webif');

    #RURIコード認証
    $admini->CheckAuthorized;

    # 他の編集画面へのリンク
    my $editlinks = &editpagelinks ('');

    #編集画面HTML
    print <<EOF;
$editlinks
<hr>
<h2>日記編集画面</h2>

<hr>

<!-- 日付指定 -->
	<form method="POST" action="./webif.cgi">
		昨日($y_year年$y_month月$y_day日)
		<input type="hidden" name="action" value="display">
		<input type="hidden" name="year" value="$y_year">
		<input type="hidden" name="month" value="$y_month">
		<input type="hidden" name="day" value="$y_day">
		<input type=submit value="の日記を編集">
	</form>
	<form method="POST" action="./webif.cgi">
		指定日
		<input type="hidden" name="action" value="display">
		<input type="text" name="year" value="$year" size=4>年
		<input type="text" name="month" value="$month" size=2>月
		<input type="text" name="day" value="$day" size=2>日
		<input type=submit value="の日記を編集">
	</form>

	<hr>

<!-- 一日分について -->

	<p>$year年$month月$day日の日記を編集</p>

<!-- 追加or編集 -->
	<form method="POST" action="./webif.cgi">
		<input type="hidden" name="action" value="edit">
		<input type="hidden" name="year" value="$year">
		<input type="hidden" name="month" value="$month">
		<input type="hidden" name="day" value="$day">
		本文<br>
		<textarea name="body" cols="80" rows="20">$text</textarea><br>
		パスワード<input type="password" name="password">
		<input type="hidden" name="secret" value="$secret">
		<input type="submit" value="登録">
		<input type="reset" value="やりなおし">
	</form>

	<hr>
	<p>$year年$month月$day日の日記を削除</p>
<!-- 削除 -->
	<form method="POST" action="./webif.cgi">
		<input type="hidden" name="year" value="$year">
		<input type="hidden" name="month" value="$month">
		<input type="hidden" name="day" value="$day">
		<input type="hidden" name="action" value="delete">
		パスワード<input type="password" name="password">
		<input type="hidden" name="secret" value="$secret">
		<input type="submit" value="この日のhnfを削除">
	</form>
	
	<hr>

	<ul>
		<li>基本的に直接 hnf を記述する場合と同じように入力してください。
		<li>hnfヘッダ部と本文の間には1行空白を開けてください。
		<li>参考: <a href="http://www.h14m.org/docs/hnf-j.html">日記の書き方</a>
	</ul>

EOF

#フッタ出力
    $admini->PrintFooter("HNS webif, ");
}

################
#hnfを削除
sub DeleteDiary ($$$$)
{
    my ($year, $month, $day, $password) = @_;
    my $date = sprintf("%04d%02d%02d",$year,$month,$day);
    my $file = &makehnfname($year, $month, $day);

    &Delete ('',$date,$password,$file)
}


################
# hnfを登録
sub RegistDiary ($$$$;$)
{
    my ($year, $month, $day, $password, $text) = @_;
    my $date = sprintf("%04d%02d%02d",$year,$month,$day);
    my $file = &makehnfname($year, $month, $day);

    if ($Mode == 0) {
	#mail2nikki経由で登録
	$text =~ s/\r\n/\n/g;
	$text =~ s/\r/\n/g;
	
	#mail2nikkiでは、hnfヘッダ部にOKを自動的につけてくれるので削除しておく。
	$text =~ s/^OK\n//;
	$text =~ s/\nOK\n/\n/;

	# 最後の行の改行を削除する
	chomp($text);
    }


    my $body;
    if ($Mode == 0) {
	$body =<<EOF;
DATE: $date
$text
END
EOF
    }
    elsif ($Mode == 1 || $Mode == 2) {
	$body = $text;
    }
    &Regist ('',$password,$body,$file);
}

