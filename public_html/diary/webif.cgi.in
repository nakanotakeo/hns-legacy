################################################################
# 下請け関数

# &→&amp;等の変換
sub HtmlEscape {
    my ($t) = @_;
    my %cv = ('&' => '&amp;', '"' => '&quot;',
	      '<' => '&lt;',  '>' => '&gt;');
    $t =~ s/([&<>"])/$cv{$1}||$1/ge;
    $t;
}

#編集ページへのリンクを生成する
sub editpagelinks ($)
{
    my ($curpage) = @_;
    my @links = (
	['',  "./webif.cgi?", "日記編集"],
	['P', "./webif.cgi?P", "予定編集"],
	['R', "./webif.cgi?R", "繰り返し予定編集"],
	['T', "./webif.cgi?T", "TODO編集"],
    );
    my $l;
    foreach (@links) {
	if ($curpage eq $_->[0]) {
	    $l .= qq([$_->[2]] );
	} else {
	    $l .= qq(<a href="$_->[1]">[$_->[2]]</a> );
	}
    }
    return $l;
}

#hnfファイル名生成して返す
sub makehnfname ($$$)
{
    my ($year,$month,$day) = @_;
	
    if ($HnfDir == 0){
    #集中管理
	return sprintf("%s/d%04d%02d%02d.hnf",$DiaryDir,$year,$month,$day);
    } else {
    #分散管理
	return sprintf("%s/%04d/d%04d%02d%02d.hnf",$DiaryDir,$year,$year,$month,$day);
    }
}

#月別予定ファイル名生成して返す
sub makeplanname ($$)
{
    my ($year,$month) = @_;
	
    if ($HnfDir == 0){
    #集中管理
	return sprintf("%s/y%04d%02d",$DiaryDir,$year,$month);
    } else {
    #分散管理
	return sprintf("%s/%04d/y%04d%02d",$DiaryDir,$year,$year,$month);
    }
}

#todoファイル名生成して返す
sub maketodoname ()
{
    return sprintf("%s/todo",$DiaryDir);
}

#repeatファイル名生成して返す
sub makerepeatname ()
{
    return sprintf("%s/repeat",$DiaryDir);
}

#削除共通
sub Delete ($$$$)
{
    my ($obj, $date, $password, $file) = @_;

    my $admini = new HNS::Admini;
    $admini->CheckAuthorized(1);

    if (&check_secret) {
        # Pass
    }
   else {
        $admini->PrintHeader('HNS webif');
        print <<EOF;
Unauthorized Access!
EOF
        $admini->PrintFooter('HNS webif');
        exit 1;
    }

    if ($Mode == 0) {
	#mail2nikki経由で削除
	#mail作成

	my $mail =<<EOF;
From: $FromUserAddress
Subject: hnf:DEL$obj

PASSWORD: $password
DATE: $date

END
EOF
	#mail送信
	&sendmail ($ToUserAddress,$mail);
    }
    elsif ($Mode == 1) {
	my $ftpfile = $file;
	$ftpfile =~ s/^$DiaryDir/$FtpDiaryDir/e;

	# use ftp client and remove
	&ftp_exec ($password, "delete $ftpfile");
    }
    elsif ($Mode == 2) {
      unlink($file);
    }

	
#日記画面にジャンプ
	print <<EOF;
Location: $DiaryURI


EOF
}

# 登録共通
sub Regist ($$$$)
{
    my ($obj, $password, $body, $file) = @_;

    my $admini = new HNS::Admini;
    $admini->CheckAuthorized(1);

    if (&check_secret) {
	# Pass
    }
   else {
	$admini->PrintHeader('HNS webif');
	print <<EOF;
Unauthorized Access!
EOF
	$admini->PrintFooter('HNS webif');
	exit 1;
    }


    # get dirname from filename
    my $dir = $file;
    $dir =~ s!/[^/]*$!!;

    if ($Mode == 0) {
       #mail作成
       my $mail =<<EOF;
From: $FromUserAddress
Subject: hnf:DEL&ADD$obj

PASSWORD: $password
${body}
EOF

	#mail送信
	&sendmail ($ToUserAddress,$mail);
    }
    elsif ($Mode == 1) {
	my $tmp = &make_temp_files;
	my $ftpfile = $file;
	$ftpfile =~ s/^$DiaryDir/$FtpDiaryDir/e;

	# write to tmp file
	open (F, ">$tmp");
	print F $body;
	close (F);

	# use ftp client and put
	&ftp_exec ($password, "mkdir $dir\nput $tmp $ftpfile");
    }
    elsif ($Mode == 2) {
	# if dir is not exist, make it
	if ( ! -d $dir ) {
	  mkdir($dir, $Permission) || die ("Can't create dir $dir\n");
	}

	# write to hnf file
	open (F, ">$file");
	print F $body;
	close (F);
    }


#日記画面にジャンプ
	print <<EOF;
Location: $DiaryURI


EOF
}

# sendmail でメールを送る
sub sendmail ($@)
{
    my ($to, @text) = @_;
	
    open (SENDMAIL, "|$Sendmail $to") || die "Can't find sendmail :$!\n";

    my $line;
    foreach $line (@text){
        #漢字コードはJIS(iso-2022-jp)に
	CodeConv::tojis(\$line);
	print SENDMAIL $line;
    }
    close (SENDMAIL);
}

# ftp clientをバッチ的に実行
sub ftp_exec ($$)
{
    my ($password, $cmds) = @_;
    local (*F);
    my $log = &make_temp_files;
    my $out;

    open (F, "|$Ftp -n $FtpHost 2>&1 >$log");
    print F "user $FtpUser $password\n";
    print F "$cmds\n";
    close F;

    open (F, $log);
    while (<F>) {
	$out .= $_;
    }
    close F;

    if ($out =~ /incorrect|failed|not\s+connect/i) {
	die "ftp send error\n<PRE>$out</PRE>";
    }
}

###
sub die_handler {
    my $msg = shift;
    if ($msg !~ /unimplemented/ &&
	$msg !~ /eval/){
	print "content-type: text/html\n\n";
	print "<br>";
	print qq(<font color="red">Error Occured: $msg</font><br>);
    }
    &unlink_temp_files;
}

###
sub unlink_temp_files  {
    for (@tempfiles) {
	unlink $_;
    }
}

###
sub make_temp_files {
    my $file;
    while ($file eq '') {
	$file = sprintf("%s/wi%05d", $HNS::System::CacheDir, int(rand 100000));
	$file = '' if (-e $file);
    }
    push (@tempfiles, $file);
    return $file;
}

###
sub check_secret {
    my $pass = 0;
    my $admini = new HNS::Admini;
    my $id = $admini->status->id;
    my $secret = param('secret');
    if ($secret eq "") {
	$secret = "none";
    }

    if ($secret eq crypt(substr($id, 4), $secret)) {
	$pass = 1;
    }

    return $pass;
}

# end of webif.cgi
