# 月別予定ファイル
sub PlanMain ()
{
    my $action = param('action');
    my $year = CGI::Tools::Escape(param('year'));
    my $month = CGI::Tools::Escape(param('month'));

    if ($action eq "display") {    #指定月の予定を編集画面に表示
	DisplayPlan($year, $month);
    } elsif ($action eq "delete"){ #指定月の予定を削除
	DeletePlan(param('year'), param('month'), param('password'));
    } elsif ($action eq "edit") {  #指定月の予定を登録
	RegistPlan(param('year'), param('month'), param('password'),
	       param('body'));
    } else {                       #今月の予定を表示
	DisplayPlan($now_time->year,$now_time->month);
    }
}

