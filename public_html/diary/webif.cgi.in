#予定を削除
sub DeletePlan ($$$)
{
    my ($year, $month, $password) = @_;
    my $date = sprintf("%04d%02d",$year,$month);
    my $file = &makeplanname ($year, $month);

    &Delete (' PLAN',$date,$password,$file);
}

# 予定を登録
sub RegistPlan ($$$;$)
{
    my ($year, $month, $password, $text) = @_;
    my $date = sprintf("%04d%02d",$year,$month);
    my $file = &makeplanname ($year, $month);
    my $body;
    $body = "DATE: $date\n" if ($Mode == 0);
    $body .= $text;
    &Regist (' PLAN',$password,$body,$file);
}

