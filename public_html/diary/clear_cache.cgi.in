use strict;
use lib qw(lib);

use SimpleDB::Append;
use HNS::Admini;
use HNS::Status;
use HNS::Cache;

require './config.ph';

my $DiaryDir = $HNS::System::DiaryDir;
my $CacheDir = $HNS::System::CacheDir;
my $admini = new HNS::Admini;


# program start
$admini->PrintHeader('HNS Clear Cache');
$admini->CheckAuthorized;

my $cache = new HNS::Cache;
$cache->Clear(0);

$admini->PrintFooter("HNS Clear Cache-$version, ");
exit;

