$TITLE_CGI_URL = 'title.cgi';

$_ = $ENV{'QUERY_STRING'};
@vars = split(/&/, $_);
foreach (@vars) {
	s/%([A-F0-9][A-F0-9])/pack("C", hex($1))/gie;
	s/(.*)=(.*)/push(@{$1}, $2)/e;
}
$arg = $YEAR[0];
if ($MONTH[0] ne "ALL") {
	$arg .= $MONTH[0];
	$arg .= $DAY[0] if ($DAY[0] ne "ALL");
}

foreach (@CAT) {
	$arg .= "&CAT=$_";
}

print "Content-Type: text/html\n";
print "Location: $TITLE_CGI_URL?$arg\n\n";

