use strict;
use File::Copy;
use lib qw(lib);
use HNS::Admini;

require './config.ph';

my $diaryDir = $HNS::System::DiaryDir;
my $current_log = "$diaryDir/log/referer_log";
my $oldDir = "$diaryDir/log/OLD";
my $old_log = "$oldDir/referer_log.old";
my $admini = new HNS::Admini;


# program start
$admini->PrintHeader('HNS Rotate Log');
$admini->CheckAuthorized;

if ((-e $old_log) && (! -w $old_log)) {
  print  "Error: can't write to $old_log";
  &html_footer;
  exit;
}

if ((-e $old_log) && (! -z $old_log)) {
  print "Error: $old_log is not empty!";
  &html_footer;
  exit;
}

if (! -w $current_log) {
  print  "Error: can't write to $current_log!";
  &html_footer;
  exit;
}

if (! -w $oldDir) {
  print "Error: can't write to $oldDir!";
  &html_footer;
  exit;
}
 
copy("$current_log", "$old_log");
clear($current_log);

print "$current_log was moved to $old_log.";

$admini->PrintFooter("HNS Rotate Log-$version, ");
exit;


sub clear ($) {
  my ($file) = @_;

  open(F, ">$file") || die "$file: $!\n";
    print F;
  close(F);
}


