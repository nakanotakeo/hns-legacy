use lib qw(lib);

use CGI::QueryString;
use DateTime::Format;
use HNS;

require './config.ph';

my $hns = new HNS;

# logging
$HNS::Status->count($HNS::Status->count+1)
  if ($HNS::System::CookieFlag eq 'ON' && ! $HNS::Status->is_robot);

$hns->RecordLog(param('ref'), param('to'));

# cookie
exit unless ($HNS::System::CookieFlag eq 'ON' && ! $HNS::Status->is_robot);

my $expires = $HNS::System::CookieExpires;
if ($expires){
    $expires = sprintf("expires=%s",
	strftime("%a, %d-%b-%Y %H:%M:%S %Z",
	gmtime(CGI::Cookie::expire_calc($expires))));
}

my $path = $ENV{'SCRIPT_NAME'};
$path =~s!/?[^/]+$!!;

sub CookieMetatag($$) {
    my ($name, $value) = @_;

    if ($path) {
	printf("<meta http-equiv=\"Set-Cookie\" content=\"%s=%s; path=%s; %s\">\n",
	$name, $value, $path,
	$expires);
    } else {
	printf("<meta http-equiv=\"Set-Cookie\" content=\"%s=%s; %s\">\n",
	$name, $value, $expires);
    }
}

CookieMetatag('HnsClientID', $HNS::Status->id);
CookieMetatag('HnsClientCount', $HNS::Status->count);

