use lib qw(lib);
use HNS::Tools::HeadLine;
use HNS::AccessControl;

$HNS::Tools::HeadLine::Version = "0.0.2";

#require './config.ph'; moved to HNS::Tools::HeadLine

################################################################
# Changing cache directory if executed from command line.
unless ($ENV{'SCRIPT_NAME'}) {
	$HNS::System::CacheDir = $HNS::System::CacheDir . "_static";
}

################################################################
# access control
my $acl = new HNS::AccessControl;

################################################################
# theme Overriding
if ($HNS::System::Theme) {
    my $theme_ph = "$HNS::System::Theme/theme.ph";
    my $theme_static_ph;

    if (! $ENV{'SCRIPT_NAME'}) {
	$theme_static_ph = "$HNS::System::Theme/theme-static.ph";
	if (-f "$theme_static_ph") {
	    $theme_ph = $theme_static_ph;
	}
    }
    unless (-f "$theme_ph"){
	die "no theme file : $theme_ph";
    }
    require "$theme_ph";
} else {
    die 'no theme';
}

$HNS::Tools::HeadLine::DayTemplate =
  qq(<a href="%href" class="hide" target="diary">%year年%month月%day日</a>);
$HNS::Tools::HeadLine::New::Template =
  qq(・<a href="%href" target="diary" title="%para">%content</a>);

$HNS::Status = new HNS::Status;
HNS::Tools::HeadLine->new->main();

