#!/bin/sh 
# HyperNikkiSystem Setup Script for hns-2.2
# version 1.0.8
# 2000/9/19

# Takuro KITAME <kitame@h14m.org>
# Copyright (C) 1999,2000  Takuro KITAME, HyperNikkiSystem Project

# changed for perl version [1999/04/11]
#  by TANAKA Tomonari <tom@morito.mgmt.waseda.ac.jp>

# $Id: hns-setup.ja,v 1.22 2003/05/28 04:15:02 togawa Exp $

PATH=$PATH:/usr/sbin:/usr/lib
VERSION=`head -2 README.ja | tail -1`

hnsinstall() {
 echo
 echo "インストール中..."
 echo

 PERL=`which perl`
 SENDMAIL=`which sendmail`
 NKF=`which nkf`
 MAKE=`which gmake`     # need GNU make
 if test "$PERL" = "" || $PERL -e 'exit ($] >= 5)'; then
   PERL=`which perl5`
   if test "$PERL" = "" || $PERL -e 'exit ($] >= 5)'; then
     { echo "エラー: Perl5 がありません．"; PERL="No"; }
   fi
 fi 
 if test "$SENDMAIL" = ""; then
   { echo "エラー: sendmail がありません．"; SENDMAIL="No"; }
 fi
 if test "$NKF" = ""; then
   { echo "エラー: nkf がありません．"; NKF="No"; }
 fi
 if test "$MAKE" = ""; then
   MAKE=`which make`
   if test "$MAKE" = "" ; then
     { echo "エラー: make がありません．"; exit 1; }
   fi
 fi
 echo "perl5   : $PERL"
 echo "sendmail: $SENDMAIL"
 echo "nkf     : $NKF"
 echo "make    : $MAKE"
 echo

 mkdir /tmp/hns-setup-`whoami`/
 cp -pr . /tmp/hns-setup-`whoami`/
 cd /tmp/hns-setup-`whoami`/

 # HNS configuration files use EUC-JP, while this installer uses UTF-8.
 TITLE_EUC=$(printf '%s' "$TITLE" | iconv -f UTF-8 -t EUC-JP) || {
   echo "エラー: 日記タイトルを EUC-JP に変換できません．" >&2
   exit 1
 }
 AUTHOR_EUC=$(printf '%s' "$AUTHOR" | iconv -f UTF-8 -t EUC-JP) || {
   echo "エラー: 著者名を EUC-JP に変換できません．" >&2
   exit 1
 }

 $MAKE NIKKITITLE="$TITLE_EUC" \
      USERMAIL="$MAIL" \
      DIARYDIR="$DIARY" \
      HTMLDIR=$HTML \
      DIARYMAIL="$TOMAIL" \
      FROMADDR="$FROMMAIL" \
      PASSWORD="$PASSWD" \
      UNAGIUSE="$UNAGI" \
      PERL_PATH="$PERL" \
      SENDMAIL_PATH="$SENDMAIL" \
      NKF_PATH="$NKF" \
      MYDIARYURI="$URL" \
      THEME="$THEME" \
      ANTENNA="$ANTENNA" \
      AUTHOR="$AUTHOR_EUC" \
      MESMAIL="$MESMAIL" \
      NEWREVERSE="$NEWREVERSE" \
      USEBOARD="$USEBOARD" \
      STARTYEAR="$STARTYEAR" \
      install
 
 # Save Setting information
 rm -f $HNSSETUP
 echo "DEFTITLE=\"$TITLE\"" > $HNSSETUP
 echo "DEFMAIL=\"$MAIL\"" >> $HNSSETUP
 echo "DEFDIARY=\"$DIARY\"" >> $HNSSETUP
 echo "DEFHTML=\"$HTML\"" >> $HNSSETUP
 echo "DEFUNAGI=\"$UNAGI\"" >> $HNSSETUP
 echo "DEFTOMAIL=\"$TOMAIL\"" >> $HNSSETUP
 echo "DEFFROMMAIL=\"$FROMMAIL\"" >> $HNSSETUP
 echo "DEFPASSWD=\"$PASSWD\"" >> $HNSSETUP
 echo "DEFURL=\"$URL\"" >> $HNSSETUP
 echo "DEFTHEME=\"$THEME\"" >> $HNSSETUP
 echo "DEFANTENNA=\"$ANTENNA\"" >> $HNSSETUP
 echo "DEFAUTHOR=\"$AUTHOR\"" >> $HNSSETUP
 echo "DEFMESMAIL=\"$MESMAIL\"" >> $HNSSETUP
 echo "DEFNEWREVERSE=\"$NEWREVERSE\"" >> $HNSSETUP
 echo "DEFUSEBOARD=\"$USEBOARD\"" >> $HNSSETUP
 echo "DEFSTARTYEAR=\"$STARTYEAR\"" >> $HNSSETUP
 echo  >> $HNSSETUP

 chmod 600 $HNSSETUP

 rm -rf /tmp/hns-setup-`whoami`

 echo 
 echo "インストール完了．"
 echo "設定情報は $HNSSETUP に保存されました．"
 echo "注意: 古い config.ph があれば config.ph-old として保存されました．"
 echo "$HTML にある config.ph をお好みに修正して下さい．"
 echo
 echo "ハイパー日記システムをご利用ありがとうございます．"
}

## default setting
 DEFTITLE="HNS: Hoge's Diary"
 DEFMAIL="hoge@example.ne.jp"
 DEFDIARY="$HOME/diary"
 DEFHTML="$HOME/public_html/diary"
 DEFTOMAIL="hoge@example.ne.jp"
 DEFFROMMAIL="hoge@example.ne.jp"
 DEFPASSWD="hogehoge"
 DEFUNAGI="OFF"
 DEFURL="http://www.example.ne.jp/~hoge/diary/"
 DEFTHEME="japanese"
 DEFANTENNA="NG"
 DEFAUTHOR=""
 DEFMESMAIL=""
 DEFNEWREVERSE="0"
 DEFUSEBOARD="0"
 DEFSTARTYEAR="2001"
 HNSSETUP=$HOME/.hnssetup
 
while getopts "f:" opt; do
  case $opt in
  f )
    if [ "$OPTARG" ]; then
      HNSSETUP=$OPTARG
    fi
    ;;
  \? )
    echo "オプションが無効です．"
    exit;;
  esac
done

echo "ハイパー日記システム $VERSION のインストールを行います．"
echo "インストールの前に必ず READMEファイルをお読みください．"
echo

if [ -f $HNSSETUP ]; then
# source $HNSSETUP
 eval `cat $HNSSETUP`
 echo "以前の設定情報が見つかりました．"
 echo 
 echo "  日記のタイトル         : $DEFTITLE"
 echo "  メール・アドレス       : $DEFMAIL"
 echo "  著者                   : $DEFAUTHOR"
 echo "  日記ディレクトリ       : $DEFDIARY"
 echo "  ウェブ日記ディレクトリ : $DEFHTML"
 echo "  Namazu 検索フォーム    : $DEFUNAGI"
 echo "  日記URL                : $DEFURL"
 echo "  テーマ名               : $DEFTHEME"
 echo "  星野アンテナへの登録   : $DEFANTENNA"
 echo "  1日の内で逆順表示      : $DEFNEWREVERSE (0 ->No, 1 ->Yes)"
 echo "  掲示板機能             : $DEFUSEBOARD (0 ->No, 1 ->Yes)"
 echo "  日記開始年             : $DEFSTARTYEAR"
 echo "  メッセージ受取アドレス : $DEFMESMAIL"
 echo
 echo "  mail2nikkiの設定: "
 echo "   To:アドレス           : $DEFTOMAIL" 
 echo "   From:アドレス         : $DEFFROMMAIL" 
 echo "   パスワード            : $DEFPASSWD" 
 echo
 echo -n "この設定でよろしいですか? [Y/n]: "
 read YN
 test -n "$YN" || YN="Y"
 if [ $YN = Y -o $YN = y ]; then
    SYSTEM=$DEFSYSTEM
    TITLE=$DEFTITLE
    MAIL=$DEFMAIL
    DIARY=$DEFDIARY
    HTML=$DEFHTML
    TOMAIL=$DEFTOMAIL
    FROMMAIL=$DEFFROMMAIL
    PASSWD=$DEFPASSWD
    UNAGI=$DEFUNAGI
    URL=$DEFURL
    THEME=$DEFTHEME
    ANTENNA=$DEFANTENNA
    AUTHOR=$DEFAUTHOR
    MESMAIL=$DEFMESMAIL
    NEWREVERSE=$DEFNEWREVERSE
    USEBOARD=$DEFUSEBOARD
    STARTYEAR=$DEFSTARTYEAR
    hnsinstall
    exit 0;
 fi
fi

echo "日記のタイトルを入力してください: [$DEFTITLE]"
echo -n "> "
read TITLE
if [ -z "$TITLE" ]; then
    TITLE=$DEFTITLE
fi

echo
echo "日記のURLを入力してください: [$DEFURL]"
echo -n "> "
read URL
if [ -z "$URL" ]; then
    URL=$DEFURL
fi

echo
echo "メール・アドレスを入力してください: [$DEFMAIL]"
echo -n "> "
read MAIL
if [ -z "$MAIL" ]; then
    MAIL=$DEFMAIL
fi

echo
echo "著者名を入力してください。"
echo "空欄でも構いません: [$DEFAUTHOR]"
echo -n "> "
read AUTHOR
if [ -z "$AUTHOR" ]; then
    AUTHOR=$DEFAUTHOR
fi

echo
echo "mail2nikki用の To:アドレス を入力してください: [$MAIL]"
echo -n "> "
read TOMAIL
if [ -z "$TOMAIL" ]; then
    TOMAIL=$MAIL
fi

echo
echo "mail2nikki用の From:アドレスを入力してください: [$MAIL]"
echo -n "> "
read FROMMAIL
if [ -z "$FROMMAIL" ]; then
    FROMMAIL=$MAIL
fi

echo
echo "mail2nikki用のパスワードを入力してください: [$DEFPASSWD]"
echo -n "> "
read PASSWD
if [ -z "$PASSWD" ]; then
    PASSWD=$DEFPASSWD
fi

echo
echo -n "Namazu の検索フォームを日記に表示しますか? [y/N]: "
read yn
test -n "$yn" || yn="N"
case "$yn" in
    [Yy]*)
        UNAGI=ON
        ;;
    *)
        UNAGI=OFF
        ;;
esac

echo
echo "テーマ名を入力してください: [$DEFTHEME]"
echo -n "> "
read THEME
if [ -z "$THEME" ]; then
    THEME=$DEFTHEME
fi

echo
echo -n "捕捉された場合，星野アンテナに登録してよろしいですか? [y/N]: "
read yn
test -n "$yn" || yn="N"
case "$yn" in
    [Yy]*)
        ANTENNA=OK
        ;;
    *)
        ANTENNA=NG
        ;;
esac

echo
echo -n "1日の内でセクション(段落)を逆順表示しますか? [y/N]: "
read yn
test -n "$yn" || yn="N"
case "$yn" in
    [Yy]*)
        NEWREVERSE=1
        ;;
    *)
        NEWREVERSE=0
        ;;
esac

echo -n "掲示板機能を使用しますか? [y/N]: "
read yn
test -n "$yn" || yn="N"
case "$yn" in
    [Yy]*)
        USEBOARD=1
	;;
    *)
	USEBOARD=0
	;;
esac

echo
echo "日記を書き始める年を入力してください: [$DEFSTARTYEAR]"
echo -n "> "
read STARTYEAR
if [ -z "$STARTYEAR" ]; then
    STARTYEAR=$DEFSTARTYEAR
fi

echo
echo "メッセージ受取アドレスを入力してください。"
echo "sendmail相当のプログラムがサーバに必要です。"
echo "受け取らない場合は空欄にして下さい: [$DEFMESMAIL]"
echo -n "> "
read MESMAIL
if [ -z "$MESMAIL" ]; then
    MESMAIL=$DEFMESMAIL
fi


echo
echo "日記ディレクトリは $DEFDIARY です．"
echo "ウェブ日記ディレクトリは $DEFHTML です．"
echo -n "これらのディレクトリを変更しますか? [y/N]:"
read yn
test -n "$yn" || yn="N"

case "$yn" in
    [Yy]*)
        echo
	echo "日記ディレクトリを入力してください: [$DEFDIARY]"
	echo -n "> "
	read DIARY
	if [ -z "$DIARY" ]; then
	    DIARY=$DEFDIARY
	fi
	echo
	echo "ウェブ日記ディレクトリを入力してください: [$DEFHTML]"
	echo -n "> "
	read HTML
	if [ -z "$HTML" ]; then
	    HTML=$DEFHTML
	fi
	;;
    *)
        DIARY=$DEFDIARY
        HTML=$DEFHTML
	;;
esac

echo
echo " 日記のタイトル         : $TITLE"
echo " メール・アドレス       : $MAIL"
echo " 著者                   : $AUTHOR"
echo " 日記ディレクトリ       : $DIARY"
echo " ウェブ日記ディレクトリ : $HTML"
echo " Namazu 検索フォーム    : $UNAGI"
echo " 日記URL                : $URL"
echo " テーマ名               : $THEME"
echo " 星野アンテナへの登録   : $ANTENNA"
echo " 1日の内で逆順表示      : $NEWREVERSE (0 ->No, 1 ->Yes)"
echo " 掲示板機能             : $USEBOARD (0 ->No, 1 ->Yes)"
echo " 日記開始年             : $STARTYEAR"
echo " メッセージ受取アドレス : $MESMAIL"
echo
echo " mail2nikkiの設定: "
echo "  To:アドレス           : $TOMAIL"
echo "  From:アドレス         : $FROMMAIL" 
echo "  パスワード            : $PASSWD" 
echo
echo -n "これでよろしいですか? [y/N]: "
read YN
test -n "$YN" || YN="N"
if [ $YN = Y -o $YN = y ]; then
    hnsinstall
    exit
else
    echo "インストールは中止されました．"
    echo
    exit
fi

