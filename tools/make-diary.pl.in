: # use perl
    eval 'exec perl -S $0 "$@"'
        if $runnning_under_some_shell;

# static diary html maker for hns
# Version: 0.0.4 (safe static-generation updates)
# 2000/10/15 Kenji Suzuki, HyperNikkiSystem Project
# Copyright (C) 2000 Kenji Suzuki, HyperNikkiSystem Project
# This program is free software under the GNU General Public License,
# version 2 or (at your option) any later version.
# This file must be encoded in EUC-JP encoding.

use strict;
use Getopt::Std;
use File::Temp qw(tempfile);

use vars qw($opt_f $opt_h $opt_s);

my $html_dir = "%HTMLDIR%";
my $hns = "$html_dir/index.cgi";
my $default_suffix = ".html";

require "$html_dir/config.ph";
getopts('fhs:') || usage();
usage() if $opt_h;

my $suffix = defined($opt_s) ? $opt_s : $default_suffix;
# A suffix is a filename extension, not a path.
$suffix =~ /\A\.[A-Za-z0-9_-]+\z/ or die "Invalid suffix: $suffix\n";

my $start = time;
my $year = (localtime($start))[5] + 1900;
my $lastmod = 0;
my $failures = 0;
$| = 1;

chdir($html_dir) or die "Cannot chdir to $html_dir: $!\n";

sub generate {
    my ($name, $argument, $mtime) = @_;
    my $destination = "$html_dir/$name";
    my ($fh, $temporary) = tempfile('.make-diary-XXXXXXXX', DIR => $html_dir, UNLINK => 0);
    print "creating $destination ...";

    my $pid = fork();
    if (!defined $pid) {
        warn "fork failed for $name: $!\n";
        close $fh;
        unlink $temporary;
        print " failed.\n";
        return 0;
    }
    if ($pid == 0) {
        delete @ENV{qw(HTTP_COOKIE COOKIE)};
        $ENV{HNS_STATIC_GENERATION} = 1;
        $ENV{REQUEST_URI} = $name;
        open(STDOUT, '>&', $fh) or die "Cannot redirect stdout: $!\n";
        close $fh;
        my @command = ($^X, '-I.', '-Ilib', $hns);
        push @command, $argument if defined $argument;
        exec { $^X } @command;
        die "Cannot execute $hns: $!\n";
    }
    close $fh;
    waitpid($pid, 0);
    my $status = $?;
    my $size = -s $temporary;
    if ($status != 0 || !$size) {
        warn "Generation failed for $name (status=$status, bytes=" . ($size || 0) . ")\n";
        unlink $temporary;
        print " failed.\n";
        return 0;
    }
    # Strip CGI-host-dependent tags from generated static HTML.
    # Work on raw bytes to preserve EUC-JP content.
    open(my $input, '<', $temporary) or die "Cannot read $temporary: $!\n";
    my ($filtered_fh, $filtered_path) =
        tempfile('.make-diary-filtered-XXXXXXXX', DIR => $html_dir, UNLINK => 0);
    while (my $line = <$input>) {
        next if $line =~ /<base\s+href\s*=/i;
        next if $line =~ /<link\s+rel=["']alternate["'][^>]*rss\.cgi/i;
        print {$filtered_fh} $line or die "Cannot write $filtered_path: $!\n";
    }
    close($input) or die "Cannot close $temporary: $!\n";
    close($filtered_fh) or die "Cannot close $filtered_path: $!\n";
    unlink $temporary or die "Cannot remove $temporary: $!\n";
    $temporary = $filtered_path;

    if (!rename($temporary, $destination)) {
        warn "Cannot rename $temporary to $destination: $!\n";
        unlink $temporary;
        print " failed.\n";
        return 0;
    }
    chmod(0644, $destination)
        or warn "Cannot chmod $destination: $!\n";
    if (!utime(time(), $mtime, $destination)) {
        warn "Cannot set modification time on $destination: $!\n";
    }
    print " done.\n";
    return 1;
}

foreach my $yy ($HNS::System::StartYear .. $year) {
    my @monthly_mtime;
    for my $dir ($HNS::System::DiaryDir, "$HNS::System::DiaryDir/$yy") {
        opendir(my $dh, $dir) or next;
        while (my $file = readdir($dh)) {
            if ($file =~ /^d\Q$yy\E(\d\d)\d\d\.hnf$/) {
                my $month = int($1);
                next if $month < 1 || $month > 12;
                my $mtime = (stat("$dir/$file"))[9];
                next unless defined $mtime;
                $monthly_mtime[$month] = $mtime
                    if !defined($monthly_mtime[$month]) || $monthly_mtime[$month] < $mtime;
                $lastmod = $mtime if $lastmod < $mtime;
            }
        }
        closedir($dh);
    }
    for my $mm (1 .. 12) {
        next unless defined $monthly_mtime[$mm];
        my $name = sprintf('%04d%02d%s', $yy, $mm, $suffix);
        my $destination = "$html_dir/$name";
        if ($opt_f || !-f $destination || (stat($destination))[9] < $monthly_mtime[$mm]) {
            $failures++ unless generate($name, sprintf('%04d%02d', $yy, $mm), $monthly_mtime[$mm]);
        }
    }
}

if ($lastmod) {
    my $name = "recent$suffix";
    my $destination = "$html_dir/$name";
    if ($opt_f || !-f $destination || (stat($destination))[9] < $lastmod) {
        $failures++ unless generate($name, undef, $lastmod);
    }
} else {
    warn "No diary files found; recent page not generated.\n";
}

print "\n", time() - $start, " seconds. ", $failures, " failed.\n";
exit($failures ? 1 : 0);

sub usage {
    die "Usage: $0 [-f] [-h] [-s suffix]\n" .
        "    -f          Force update.\n" .
        "    -h          Print this help.\n" .
        "    -s <suffix> Set suffix (default '$default_suffix').\n";
}
