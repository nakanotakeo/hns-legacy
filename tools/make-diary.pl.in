: # use perl
    eval 'exec perl -S $0 "$@"'
        if $runnning_under_some_shell;

# static diary html maker for hns
# Version: 0.0.4
# 2000/10/15  Kenji Suzuki <kenji@h14m.org>

# Copyright (C) 2000  Kenji Suzuki, HyperNikkiSystem Project

